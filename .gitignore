# Игнорировать ВСЁ по умолчанию
*

# Но разрешить следующие файлы и папки:
!/.gitignore  # сам .gitignore
!/src/**      # папка src и всё внутри
!/pom.xml     # файл pom.xml
!/README.md   # файл README.md (варианты с разным регистром)
!/README.MD
!/readme.md

# Явно скрыть .env
.env
*.env

# Дополнительные исключения
!.mvn/wrapper/maven-wrapper.jar
!**/.gitkeep

### Стандартные исключения для Java/Maven ###
# Логи и временные файлы
*.log
*.tmp
*.bak

# Файлы IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
bin/
out/
target/

# Системные файлы
.DS_Store
Thumbs.db