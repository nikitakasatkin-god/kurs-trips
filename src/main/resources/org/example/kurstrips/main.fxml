<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<TabPane fx:id="tabPane" xmlns="http://javafx.com/javafx/11.0.1"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="org.example.kurstrips.controller.MainController">

  <Tab text="Построение маршрута">
    <VBox spacing="10">
      <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
      </padding>

      <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="startField" promptText="Откуда (адрес)" prefWidth="300"/>
        <TextField fx:id="endField" promptText="Куда (адрес)" prefWidth="300"/>
        <Button fx:id="buildRouteBtn" text="Построить прямой маршрут"/>
        <Button fx:id="buildOptimalRouteBtn" text="Построить оптимальный маршрут"/>
      </HBox>

      <Label fx:id="routeInfoLabel" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
      <VBox fx:id="citiesListContainer" spacing="5" style="-fx-padding: 0 0 0 20;"/>

      <WebView fx:id="webView" prefHeight="300" VBox.vgrow="ALWAYS"/>

      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Бюджет:"/>
        <TextField fx:id="budgetField" promptText="Бюджет поездки" prefWidth="100"/>
        <Label text="Дата начала:"/>
        <DatePicker fx:id="startDatePicker" prefWidth="150"/>
        <Label text="Дата окончания:"/>
        <DatePicker fx:id="endDatePicker" prefWidth="150"/>
        <Button fx:id="addTripButton" text="Добавить поездку"/>
      </HBox>
    </VBox>
  </Tab>

  <Tab text="Мои поездки">
    <VBox spacing="10">
      <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
      </padding>

      <Label text="Все поездки:" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
      <TableView fx:id="tripsTable" prefHeight="250">
        <columns>
          <TableColumn fx:id="fromCityColumn" text="Откуда" prefWidth="150"/>
          <TableColumn fx:id="toCityColumn" text="Куда" prefWidth="150"/>
          <TableColumn fx:id="datesColumn" text="Даты" prefWidth="200"/>
          <TableColumn fx:id="budgetColumn" text="Бюджет" prefWidth="100"/>
          <TableColumn fx:id="statusColumn" text="Статус" prefWidth="100"/>
          <TableColumn fx:id="ratingColumn" text="Оценка" prefWidth="80"/>
        </columns>
      </TableView>

      <Label text="Отзывы:" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
      <TableView fx:id="reviewsTable" prefHeight="150">
        <columns>
          <TableColumn fx:id="tripRouteColumn" text="Маршрут" prefWidth="200"/>
          <TableColumn fx:id="reviewRatingColumn" text="Оценка" prefWidth="80">
            <cellValueFactory>
              <PropertyValueFactory property="rating" />
            </cellValueFactory>
          </TableColumn>
          <TableColumn fx:id="reviewCommentColumn" text="Отзыв" prefWidth="400"/>
        </columns>
      </TableView>

      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Оценка:"/>
        <Slider fx:id="ratingSlider" min="1" max="5" value="3" showTickLabels="true"
                showTickMarks="true" majorTickUnit="1" minorTickCount="0" snapToTicks="true"
                prefWidth="150"/>
        <Label text="Отзыв:"/>
        <TextArea fx:id="reviewTextArea" promptText="Ваш отзыв" prefWidth="300" prefHeight="60"/>
        <Button fx:id="submitReviewButton" text="Добавить отзыв" style="-fx-font-weight: bold;"/>
      </HBox>
    </VBox>
  </Tab>
</TabPane>