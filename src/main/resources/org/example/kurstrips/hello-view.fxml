<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.kurstrips.HelloController" spacing="10">
  <padding>
    <Insets top="10" right="10" bottom="10" left="10"/>
  </padding>

  <HBox spacing="10" alignment="CENTER_LEFT">
    <TextField fx:id="startField" promptText="Откуда (адрес)" prefWidth="300"/>
    <TextField fx:id="endField" promptText="Куда (адрес)" prefWidth="300"/>
    <Button fx:id="buildRouteBtn" text="Построить маршрут"/>
    <Button text="Тест" onAction="#testButtonClicked"/>
    <Button text="ТестБаз" onAction="#testMap"/>
  </HBox>


  <WebView fx:id="webView" prefHeight="500" VBox.vgrow="ALWAYS"/>
</VBox>